\frametitle{Reproducibility and code structure}
\scriptsize
\textbf{Engineering (open + reproducible)}
\begin{itemize}
  \item Worked 50/30 hours, wrote 2k LOC, 30 notebooks, 73 commits, We open-source the code.
  \item  \textbf{We re-implement the full pipeline.}

\end{itemize}

\vspace{0.25em}
\begin{center}
\begin{minipage}{0.88\linewidth}
\begin{beamerboxesrounded}[shadow=true]{1-liner installation}
\begin{verbatim}
chmod +x launch.sh && ./launch.sh
\end{verbatim}
\end{beamerboxesrounded}
\end{minipage}
\end{center}

